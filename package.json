{
  "name": "umami-telegram-reporter",
  "version": "1.0.0",
  "description": "Autonomous Telegram analytics reporting service for Umami",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "check:types": "tsc --noEmit",
    "test": "bun test",
    "check-config": "bun run src/cli/check-config.ts",
    "dry-run": "bun run src/cli/dry-run.ts",
    "check": "bun run check:types && bun test"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "croner": "^9.0.0",
    "grammy": "^1.35.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
