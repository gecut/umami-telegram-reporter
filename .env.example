# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef-ghIJKlmnoPQRsTUVwxyZ01234567

# Umami API Base URL
# Umami Cloud: https://api.umami.is/v1
# Self-Hosted: https://your-umami-domain.com/api
UMAMI_BASE_URL=https://api.umami.is/v1

# Umami API Key (Cloud) or Bearer Token (Self-Hosted)
UMAMI_API_KEY=your_umami_api_key_or_token

# Optional: Path to projects configuration file (default: ./projects.json)
PROJECTS_CONFIG_PATH=./projects.json

# Optional: Log Level (debug, info, warn, error)
LOG_LEVEL=info
